# Local example values (no real secrets). docker-compose.yml already sets
# these for the containers; export them to run the binary on the host:
#   set -a; source .env.example; set +a; go run ./cmd/wallet-service serve

INSTANCE_ID=local-1
LOG_LEVEL=info

# Components (all enabled = single all-in-one process). docker-compose.yml runs
# each component as its own service with only its own credentials.
API_ENABLED=true
SQS_CONSUMER_ENABLED=true
PENDING_WORKER_ENABLED=true
OUTBOX_ENABLED=true
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# Runtime roles (least privilege) and migration owner
# wallet_app: API, consumer and pending worker (moves money)
DATABASE_URL=postgres://wallet_app:wallet_app_local@localhost:5432/wallet?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallet?sslmode=disable
DATABASE_MAX_CONNS=20

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=wallet-service
AWS_SECRET_ACCESS_KEY=wallet-service-local
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_INGRESS_QUEUE=wager-transactions.fifo
SQS_INGRESS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=10s
SQS_VISIBILITY_TIMEOUT=30s
SQS_HANDLER_TIMEOUT=10s
SQS_MAX_RECEIVES=5
SQS_CONCURRENCY=4
SQS_RETRY_BASE_DELAY=2s
SQS_RETRY_MAX_DELAY=60s
SQS_ALLOWED_PROVIDERS=provider-a,provider-b

# Transactional outbox relay
# wallet_relay: reads outbox_events and updates only its delivery columns
OUTBOX_DATABASE_URL=postgres://wallet_relay:wallet_relay_local@localhost:5432/wallet?sslmode=disable
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_BASE_BACKOFF=1s
OUTBOX_MAX_BACKOFF=5m

# Pending references
PENDING_POLL_INTERVAL=1s
PENDING_BATCH_SIZE=50
REFERENCE_MAX_ATTEMPTS=12
REFERENCE_BASE_DELAY=1s
REFERENCE_MAX_DELAY=1m
REFERENCE_TTL=30m

# OIDC (Keycloak). Tokens are issued for http://localhost:8180; the JWKS may be
# fetched through another address (e.g. http://keycloak:8080 inside compose).
OIDC_ISSUER=http://localhost:8180/realms/jungle
OIDC_JWKS_URL=http://localhost:8180/realms/jungle/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
OIDC_PROVIDER_CLAIM=provider_id
OIDC_PROVIDER_ROLE=wagering-provider
OIDC_INTERNAL_ROLE=wallet-internal

# Fault injection for recovery tests only:
# consumer-crash-after-commit | outbox-crash-after-publish
FAULT_INJECTION=
